{
  "name": "Google Organic Live Advanced",
  "method": "POST",
  "path": "/v3/serp/google/organic/live/advanced",
  "desc": [
    "实时获取 Google 有机搜索排名数据",
    "包含 SERP 各类高级元素（知识图谱、精选摘要、People Also Ask 等）"
  ],
  "params": [
    {
      "name": "keyword",
      "type": "string",
      "desc": [
        "必填项",
        "目标查询关键词",
        "例如：seo audit tools"
      ]
    },
    {
      "name": "location_code",
      "type": "number",
      "desc": [
        "搜索区域国家/地区代码",
        "常用值参考：",
        "- 2840：美国",
        "- 2826：英国",
        "- 2124：加拿大"
      ]
    },
    {
      "name": "language_code",
      "type": "string",
      "desc": [
        "搜索语言代码",
        "例如：en、zh-CN、ja"
      ]
    },
    {
      "name": "depth",
      "type": "number",
      "desc": [
        "抓取深度（搜索结果条数）",
        "默认值为 100",
        "最大支持设置为 700"
      ]
    }
  ]
}
